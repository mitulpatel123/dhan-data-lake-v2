# Credential-free PostgreSQL demonstration
POSTGRES_DB=dhan_lake
POSTGRES_USER=dhan
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://dhan:local_only_change_me@postgres:5432/dhan_lake
DATA_INPUT_PATH=/app/data/sample/market_bars.csv

# Optional live DhanHQ integration. Never commit real values.
PRIMARY_DHAN_CLIENT_ID=
PRIMARY_DHAN_ACCESS_TOKEN=
SECONDARY_DHAN_CLIENT_ID=
SECONDARY_DHAN_ACCESS_TOKEN=

# Legacy MongoDB integration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dhan_data_lake

LOG_LEVEL=INFO
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PER_SECOND=9
