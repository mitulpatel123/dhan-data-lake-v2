# DhanHQ API Key 1 (The Firehose - for WebSockets)
PRIMARY_DHAN_CLIENT_ID="YOUR_PRIMARY_CLIENT_ID"
PRIMARY_DHAN_ACCESS_TOKEN="YOUR_PRIMARY_ACCESS_TOKEN"

# DhanHQ API Key 2 (The Workhorse - for REST API)
SECONDARY_DHAN_CLIENT_ID="YOUR_SECONDARY_CLIENT_ID"
SECONDARY_DHAN_ACCESS_TOKEN="YOUR_SECONDARY_ACCESS_TOKEN"

# MongoDB Configuration
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-url>/"
MONGO_DB_NAME="dhan_data_lake"

# System Configuration
LOG_LEVEL="INFO"
LOG_FORMAT="json"
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PER_SECOND=9